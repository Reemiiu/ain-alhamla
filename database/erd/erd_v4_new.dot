ritual_counters [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white" color="#E4DCC8"><tr><td bgcolor="#C9A24A" colspan="2" port="__t"><font color="white"><b>ritual_counters</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b></td><td align="left"><font color="#9C9585">bigint</font></td></tr><tr><td align="left" port="pilgrim_id">FK pilgrim_id</td><td align="left"><font color="#9C9585">bigint</font></td></tr><tr><td align="left" port="kind">kind</td><td align="left"><font color="#9C9585">counter_kind</font></td></tr><tr><td align="left" port="hajj_day">hajj_day</td><td align="left"><font color="#9C9585">smallint</font></td></tr><tr><td align="left" port="count">count</td><td align="left"><font color="#9C9585">smallint</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left"><font color="#9C9585">timestamptz</font></td></tr></table>>];
ritual_guides [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white" color="#E4DCC8"><tr><td bgcolor="#C9A24A" colspan="2" port="__t"><font color="white"><b>ritual_guides</b></font></td></tr><tr><td align="left" port="id"><b>PK id</b></td><td align="left"><font color="#9C9585">bigint</font></td></tr><tr><td align="left" port="hajj_day">hajj_day</td><td align="left"><font color="#9C9585">smallint</font></td></tr><tr><td align="left" port="lang">lang</td><td align="left"><font color="#9C9585">varchar(5)</font></td></tr><tr><td align="left" port="title">title</td><td align="left"><font color="#9C9585">varchar(100)</font></td></tr><tr><td align="left" port="steps">steps</td><td align="left"><font color="#9C9585">jsonb</font></td></tr><tr><td align="left" port="dua">dua</td><td align="left"><font color="#9C9585">text</font></td></tr><tr><td align="left" port="tip">tip</td><td align="left"><font color="#9C9585">text</font></td></tr></table>>];
}
