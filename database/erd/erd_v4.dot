digraph ERD {
graph [rankdir=LR, fontname="Tajawal", nodesep=0.35, ranksep=0.9, pad=0.4, bgcolor="#FAF7EF", splines=true, label=<<b>عين الحملة — مخطط علاقات الكيانات (ERD) v4</b><br/><font point-size="11">38 جدولاً · 83 علاقة · مولّدة من القاعدة الفعلية · الجداول الذهبية = جديدة في v3/v4 (المتابعة الذكية ومميزات الحج) · ★ = عمود جديد</font>>, labelloc=t, fontsize=20];
node [shape=plain, fontname="Tajawal", fontsize=10];
edge [color="#5B564C", arrowhead=crow, arrowtail=none, penwidth=1.1, fontname="Tajawal", fontsize=8];
